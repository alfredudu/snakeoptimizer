# Quebras de linha CRLF nos arquivos do projeto (o cmd.exe e o Windows PowerShell 5.1 esperam isso).
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
# Baixado sozinho pelo link "raw" do GitHub (sem passar pelo git): guardado já com CRLF, sem conversão.
Abrir-SnakeOptimizer.cmd -text
*.xaml  text eol=crlf
*.md    text eol=crlf
*.yml   text eol=crlf
*.json  text eol=crlf
*.svg   text eol=crlf

# O ícone é binário: nenhuma conversão de quebra de linha.
*.ico   binary

LICENSE text eol=lf
